# =============================================================================
#  Lawyer OS Template — environment variables
#  Copy to ".env.local" and fill in real values. NEVER commit .env.local.
#  Everything except NEXT_PUBLIC_* is read ONLY on the server.
# =============================================================================

# --- Site ---
SITE_URL=https://www.liorerezadv.com

# --- Cloudinary (media) — public-safe cloud name ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# --- AI chatbot (SERVER-ONLY) ---
# Set ONE provider's key. Without any key the chat answers from the knowledge
# base (src/lib/knowledge.ts) and the guided intake still works.
#
# Option 1: Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Claude model.
CHAT_MODEL=claude-sonnet-5-5
#
# Option 2: Gemini (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model.
GEMINI_MODEL=gemini-2.5-flash
#
# Optional: force a provider when both keys are set (anthropic | google).
CHAT_PROVIDER=

# --- RAG embeddings (OPTIONAL, SERVER-ONLY) ---
# Only needed to enable retrieval over your knowledge base. Without it, the
# chatbot still works using its built-in firm knowledge.
OPENAI_API_KEY=sk-...

# --- Supabase (OPTIONAL, SERVER-ONLY) — chat history + RAG ---
# Without these, chat history and RAG are simply disabled (graceful fallback).
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- WhatsApp: Meta Cloud API (OPTIONAL, SERVER-ONLY) ---
# Lets the lead form deliver straight to the office WhatsApp from the server.
# Without these, the form hands the visitor a prefilled wa.me link instead.
# Get them in Meta for Developers -> your app -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Office number that receives leads, digits only with country code (defaults to brand.ts).
WHATSAPP_NOTIFY_TO=
# Approved template name. Needed to message the office reliably (see README).
# Template body must have 4 variables: {{1}} name, {{2}} phone, {{3}} matter, {{4}} details.
WHATSAPP_LEAD_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=he
