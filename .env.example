# =============================================================================
#  Lawyer OS Template — environment variables
#  Copy to ".env.local" and fill in real values. NEVER commit .env.local.
#  Everything except NEXT_PUBLIC_* is read ONLY on the server.
# =============================================================================

# --- Site ---
SITE_URL=https://www.example.co.il

# --- Cloudinary (media) — public-safe cloud name ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# --- AI chatbot (SERVER-ONLY) ---
# Required for the chatbot to answer. Without it, the chat degrades gracefully.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Claude model used by the chat route.
CHAT_MODEL=claude-sonnet-4-5

# --- RAG embeddings (OPTIONAL, SERVER-ONLY) ---
# Only needed to enable retrieval over your knowledge base. Without it, the
# chatbot still works using its built-in firm knowledge.
OPENAI_API_KEY=sk-...

# --- Supabase (OPTIONAL, SERVER-ONLY) — chat history + RAG ---
# Without these, chat history and RAG are simply disabled (graceful fallback).
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Lead form (SERVER-ONLY) ---
N8N_LEAD_WEBHOOK_URL=https://your-n8n-host/webhook/lead
