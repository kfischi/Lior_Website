# =============================================================================
#  Lawyer OS Template — environment variables
#  Copy to ".env.local" and fill in real values. NEVER commit .env.local.
#  Secrets (webhook URLs) are read ONLY on the server (route handlers).
# =============================================================================

# --- Site ---
# Public base URL of the deployed site (used for canonical URLs, sitemap, SEO).
SITE_URL=https://www.example.co.il

# --- Cloudinary (media) ---
# Cloud name only — this is public-safe and used by the custom image loader.
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# --- n8n Webhooks (SERVER-ONLY — never expose with NEXT_PUBLIC_) ---
# Lead form submissions are forwarded here by /api/lead.
N8N_LEAD_WEBHOOK_URL=https://your-n8n-host/webhook/lead
# Chatbot messages are forwarded here by /api/chat.
N8N_CHAT_WEBHOOK_URL=https://your-n8n-host/webhook/chat
