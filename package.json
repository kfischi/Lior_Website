{
  "name": "lawyer-os-template",
  "version": "2.0.0",
  "private": true,
  "description": "Elite white-label master template for Israeli law-firm websites (Hebrew, RTL, Next.js 16 / React 19 / AI chatbot).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:privacy": "node --import tsx scripts/test-redact.ts",
    "ingest": "node --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "captions": "node --env-file-if-exists=.env.local --import tsx scripts/captions.ts",
    "avatar": "node --env-file-if-exists=.env.local --import tsx scripts/avatar.ts",
    "avatar:setup": "bash scripts/avatar-local/setup.sh",
    "avatar:doctor": "node --import tsx scripts/avatar-doctor.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/google": "^4.0.106",
    "@ai-sdk/openai": "^4.0.103",
    "@ai-sdk/react": "^4.0.158",
    "@netlify/blobs": "^11.1.6",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.154",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
