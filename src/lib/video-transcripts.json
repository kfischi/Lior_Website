    },
    {
      "start": 25.7,
      "end": 31.47,
      "text": "והצלחנו לבטל האשמות ולהוריד את רמת העונש."
    },
    {
      "start": 31.94,
      "end": 34.81,
      "text": "תודה רבה לך, ליאור ארז."
    },
    {
      "start": 34.81,
      "end": 39.46,
      "text": "היית לצידנו כל התקופה הזו, בעליות,"
    },
    {
      "start": 39.46,
      "end": 40.24,
      "text": "בירידות,"
    },
    {
      "start": 40.24,
      "end": 43.2,
      "text": "נתת בכנות את מלוא השעות והזמן"
    },
    {
      "start": 43.2,
      "end": 46.78,
      "text": "שהיינו צריכים כדי לקבל תמיכה מלאה."
    },
    {
      "start": 47.42,
      "end": 48.81,
      "text": "תודה רבה."
    },
    {
      "start": 48.81,
      "end": 52.54,
      "text": "כל מי שמעוניין מוזמן לפנות אליי"
    },
    {
      "start": 52.54,
      "end": 56.71,
      "text": "ולקבל המלצה אישית ולהבין על מה היה התיק,"
    },
    {
      "start": 56.71,
      "end": 57.71,
      "text": "ושוב תודה."
    }
  ],
  "/videos/review-5.mp4": [
    {
      "start": 1.1,
      "end": 4.92,
      "text": "בחודשים האחרונים עזבתי מקום עבודה"
    },
    {
      "start": 4.92,
