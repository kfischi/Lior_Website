{
  "/videos/review-1.mp4": [
    {
      "start": 0.8,
      "end": 1.34,
      "text": "שלום,"
    },
    {
      "start": 1.34,
      "end": 6.49,
      "text": "שמי… אני מיוצג על ידי עורכת הדין"
    },
    {
      "start": 6.49,
      "end": 10.8,
      "text": "ליאור ארז בשימוע נגד המעסיק הנוכחי שלי."
    },
    {
      "start": 10.8,
      "end": 12.8,
      "text": "התוצאה:"
    },
    {
      "start": 12.8,
      "end": 15.8,
      "text": "ליאור ארז הצליחה למנוע את פיטוריי,"
    },
    {
      "start": 15.8,
      "end": 18.53,
      "text": "וקיבלתי תפקיד אחר בארגון."
    },
    {
      "start": 18.53,
      "end": 22.3,
      "text": "אני רוצה להמליץ לכם מאוד על"
    },
    {
      "start": 22.3,
      "end": 26.05,
      "text": "שירותיה של עורכת הדין ליאור ארז."
    }
  ],
  "/videos/review-2.mp4": [
    {
      "start": 1.1,
      "end": 4.87,
      "text": "עורכת הדין ליאור ארז הצליחה לנקות"
    },
    {
      "start": 4.87,
      "end": 8.52,
      "text": "את שמי מהאשמה בהטרדה מינית שקרית"
    },
    {
      "start": 8.52,
      "end": 10.7,
      "text": "שהייתה בעבודה."
    },
    {
      "start": 10.7,
      "end": 14.39,
      "text": "עברתי סיוט ענק במסגרת העבודה,"
    },
    {
      "start": 14.39,
      "end": 18.9,
      "text": "והיא ניקתה את שמי מהשקרים בהצלחה גדולה,"
    },
    {
      "start": 18.9,
      "end": 21.54,
      "text": "הצליחה לעשות מה שלא עשיתי בכלל."
    },
    {
      "start": 21.54,
      "end": 23.17,
      "text": "תודה."
    }
  ],
  "/videos/review-3.mp4": [
    {
      "start": 1.6,
      "end": 3.51,
      "text": "שלום רב."
    },
    {
      "start": 3.51,
      "end": 5.88,
      "text": "רציתי להודות לעורכת הדין ליאור"
    },
    {
      "start": 5.88,
      "end": 8.8,
      "text": "ארז על כל מה שהיא עשתה בייצוג המשפטי,"
    },
    {
      "start": 9.84,
      "end": 16.1,
      "text": "על כל הליווי בנושא הוועדה בלשכת התעסוקה."
    },
    {
      "start": 16.93,
      "end": 19.54,
      "text": "אני רוצה להודות לה על כל מה שעשתה."
    },
    {
      "start": 21.36,
      "end": 25.4,
      "text": "חשוב שאציין שברוך השם הצלחנו בוועדה."
    },
    {
      "start": 25.4,
      "end": 28.28,
      "text": "אני מודה לה מכל הלב."
    },
    {
      "start": 30.59,
      "end": 32.81,
      "text": "אני לא מאמין שאם לא הייתי נכנס"
    },
    {
      "start": 32.81,
      "end": 33.7,
      "text": "איתה לוועדה,"
    },
    {
      "start": 33.7,
      "end": 39.17,
      "text": "הייתי משיג את מה שניסינו להשיג בלעדיה."
    },
    {
      "start": 41.17,
      "end": 43.26,
      "text": "המצב בהחלט לא היה משתנה."
    },
    {
      "start": 45.38,
      "end": 47.67,
      "text": "התיק שהיא לקחה הוא תיק ממש לא קל,"
    },
    {
      "start": 47.67,
      "end": 49.2,
      "text": "עקב הבעיות הרפואיות שלי"
    },
    {
      "start": 49.62,
      "end": 51.18,
      "text": "בנושא תקשורת עם הסביבה."
    },
    {
      "start": 51.18,
      "end": 52.9,
      "text": "אני סובל מבעיות שמיעתיות,"
    },
    {
      "start": 52.9,
      "end": 53.9,
      "text": "ממש קשות."
    },
    {
      "start": 56.78,
      "end": 59.8,
      "text": "אני שמח שהיא הסכימה לייצג אותי."
    },
    {
      "start": 59.8,
      "end": 63.1,
      "text": "אני רוצה להודות לך מכל הלב על כל מה שעשית."
    },
    {
      "start": 64.47,
      "end": 66.4,
      "text": "אתה אדם יקר מאוד,"
    },
    {
      "start": 66.92,
      "end": 70.5,
      "text": "ואני שוב אומר,"
    },
    {
      "start": 72.0,
      "end": 75.4,
      "text": "זה לא מן המקובל"
    },
    {
      "start": 75.99,
      "end": 79.4,
      "text": "שכל עורך דין יהיה מוכן לקבל תיק כזה קשה,"
    },
    {
      "start": 79.5,
      "end": 83.86,
      "text": "בגלל בעיות התקשורת השמיעתיות שלי."
    },
    {
      "start": 84.54,
      "end": 87.07,
      "text": "אז שוב, מכל הלב,"
    },
    {
      "start": 87.07,
      "end": 91.3,
      "text": "תודה רבה לעורכת הדין היקרה,"
    },
    {
      "start": 91.3,
      "end": 94.03,
      "text": "ליאור ארז, ואין מילים,"
    },
    {
      "start": 94.03,
      "end": 96.31,
      "text": "את משהו מיוחד. תודה."
    }
  ],
  "/videos/review-4.mp4": [
    {
      "start": 1.83,
      "end": 2.49,
      "text": "שלום,"
    },
    {
      "start": 2.49,
      "end": 6.74,
      "text": "אני רוצה להמליץ על עורכת הדין"
    },
    {
      "start": 6.74,
      "end": 8.85,
      "text": "ליאור קלואי ארז,"
