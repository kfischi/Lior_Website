{
  "/videos/review-1.mp4": [
    {
      "start": 0.8,
      "end": 1.34,
      "text": "שלום,"
    },
    {
      "start": 1.34,
      "end": 5.73,
      "text": "שמי… אני מיוצג על ידי עורכת הדין"
    },
    {
      "start": 5.73,
      "end": 10.8,
      "text": "ליאור ארז בשימוע נגד המעסיק הנוכחי שלי."
    },
    {
      "start": 10.8,
      "end": 12.99,
      "text": "התוצאה:"
    },
    {
      "start": 12.99,
      "end": 15.8,
      "text": "ליאור ארז הצליחה למנוע את פיטוריי,"
    },
    {
      "start": 15.8,
      "end": 18.77,
      "text": "וקיבלתי תפקיד אחר בארגון."
    },
    {
      "start": 18.77,
      "end": 21.98,
      "text": "אני רוצה להמליץ לכם מאוד על"
    },
    {
      "start": 21.98,
      "end": 26.03,
      "text": "שירותיה של עורכת הדין ליאור ארז."
    }
  ],
  "/videos/review-2.mp4": [
    {
      "start": 1.1,
      "end": 5.11,
      "text": "עורכת הדין ליאור ארז הצליחה לנקות"
    },
    {
      "start": 5.11,
      "end": 9.0,
      "text": "את שמי מהאשמה בהטרדה מינית שקרית"
    },
    {
      "start": 9.0,
      "end": 10.7,
      "text": "שהייתה בעבודה."
    },
    {
      "start": 10.7,
      "end": 14.2,
      "text": "עברתי סיוט ענק במסגרת העבודה,"
    },
    {
      "start": 14.2,
      "end": 18.9,
      "text": "והיא ניקתה את שמי מהשקרים בהצלחה גדולה,"
    },
    {
      "start": 18.9,
      "end": 22.34,
      "text": "הצליחה לעשות מה שלא עשיתי בכלל."
    },
    {
      "start": 22.34,
      "end": 23.15,
      "text": "תודה."
    }
  ],
  "/videos/review-3.mp4": [
    {
      "start": 1.6,
      "end": 2.89,
      "text": "שלום רב."
    },
    {
      "start": 2.89,
      "end": 5.53,
      "text": "רציתי להודות לעורכת הדין ליאור"
    },
    {
      "start": 5.53,
      "end": 8.8,
      "text": "ארז על כל מה שהיא עשתה בייצוג המשפטי,"
    },
    {
      "start": 9.6,
      "end": 16.1,
      "text": "על כל הליווי בנושא הוועדה בלשכת התעסוקה."
    },
    {
      "start": 16.2,
      "end": 20.7,
      "text": "אני רוצה להודות לה על כל מה שעשתה."
    },
    {
      "start": 20.7,
      "end": 25.4,
      "text": "חשוב שאציין שברוך השם הצלחנו בוועדה."
    },
    {
      "start": 25.4,
      "end": 28.9,
      "text": "אני מודה לה מכל הלב."
    },
    {
      "start": 29.0,
      "end": 32.24,
      "text": "אני לא מאמין שאם לא הייתי נכנס"
    },
    {
      "start": 32.24,
      "end": 33.7,
      "text": "איתה לוועדה,"
    },
    {
      "start": 33.9,
      "end": 40.8,
      "text": "הייתי משיג את מה שניסינו להשיג בלעדיה."
    },
    {
      "start": 40.9,
      "end": 44.7,
      "text": "המצב בהחלט לא היה משתנה."
    },
    {
      "start": 45.2,
      "end": 47.56,
      "text": "התיק שהיא לקחה הוא תיק ממש לא קל,"
    },
    {
      "start": 47.56,
      "end": 49.2,
      "text": "עקב הבעיות הרפואיות שלי"
    },
    {
      "start": 49.3,
      "end": 50.92,
      "text": "בנושא תקשורת עם הסביבה."
    },
    {
      "start": 50.92,
      "end": 53.61,
      "text": "אני סובל מבעיות שמיעה, ממש קשות."
    },
    {
      "start": 56.34,
      "end": 58.7,
      "text": "אני שמח שהיא הסכימה לייצג אותי."
    },
    {
      "start": 58.7,
      "end": 63.1,
      "text": "אני רוצה להודות לך מכל הלב על כל מה שעשית."
    },
    {
      "start": 64.1,
      "end": 65.57,
      "text": "את אדם יקר מאוד,"
    },
    {
      "start": 68.82,
      "end": 70.4,
      "text": "ואני, שוב, אומר,"
    },
    {
      "start": 71.86,
      "end": 73.8,
      "text": "זה לא …"
    },
    {
      "start": 74.7,
      "end": 79.21,
      "text": "מקובל שכל עורך דין יהיה מוכן לקבל"
    },
    {
      "start": 79.21,
      "end": 80.85,
      "text": "תיק כזה קשה,"
    },
    {
      "start": 80.85,
      "end": 84.0,
      "text": "בגלל בעיות התקשורת שלי."
    },
    {
      "start": 84.0,
      "end": 85.54,
      "text": "אז שוב, מכל הלב,"
    },
    {
      "start": 85.54,
      "end": 88.77,
      "text": "תודה רבה לעורכת הדין היקרה,"
    },
    {
      "start": 88.77,
      "end": 93.21,
      "text": "ליאור ארז, ואין מילים,"
    },
    {
      "start": 93.21,
      "end": 96.29,
      "text": "את משהו מיוחד. תודה."
    }
  ],
  "/videos/review-4.mp4": [
    {
